@inject IPlatformInfo Platform
<div class="section-heading"><div><span class="eyebrow">GERÄTEQUELLEN</span><h2>Beobachtete Geräte</h2></div><input class="search" aria-label="Geräte suchen" placeholder="IP, MAC oder Name suchen …" @bind="search" @bind:event="oninput" /></div>
<p class="notice">@Platform.DevicesNote</p>
<section class="panel table-panel"><table><thead><tr><th>Gerät</th><th>Adressen</th><th>MAC-Adresse</th><th>Beobachtung</th></tr></thead><tbody>
@foreach(var group in Devices){<tr><td><div class="device-label"><span class="device-symbol">@(group.Any(d => d.Name == "Gateway") ? "≋" : "▣")</span><div><strong>@(group.Select(d => d.Name).FirstOrDefault(n => n.Length > 0) ?? "Unbekanntes Gerät")</strong><small>Quelle: @(group.First().State == "Router-Syslog" ? "Router-Syslog" : Platform.PlatformLabel + "-Nachbartabelle")</small></div></div></td><td class="mono">@foreach(var d in group){<div>@d.Address</div>}</td><td class="mono">@group.Key</td><td><span class="pill @(group.Any(d => d.State == "Reachable") ? "good" : "muted")">@(group.Any(d => d.State == "Reachable") ? "Erreichbar beobachtet" : group.First().State)</span></td></tr>}
</tbody></table>@if(!Devices.Any()){<div class="empty">Keine passenden Nachbargeräte beobachtet.</div>}</section>
@code {
    [Parameter] public MonitorState State { get; set; } = new();
    private string search = "";
    private IEnumerable<IGrouping<string, DeviceInfo>> Devices => (State.Snapshot?.Devices ?? []).Where(d => $"{d.Address} {d.Mac} {d.Name}".Contains(search, StringComparison.OrdinalIgnoreCase)).GroupBy(d => d.Mac).OrderByDescending(g => g.Any(d => d.Name == "Gateway"));
}
