@inject IPlatformInfo Platform
<div class="section-heading"><div><span class="eyebrow">EREIGNISSE &amp; SYSLOG</span><h2>Was im Netzwerk passiert.</h2></div><input class="search" aria-label="Logs durchsuchen" placeholder="Nachricht oder Quelle suchen …" @bind="search" @bind:event="oninput" /></div>
<div class="toolbar"><label>Schweregrad<select @bind="severity"><option value="">Alle</option><option>Info</option><option>Warnung</option><option>Fehler</option><option>Debug</option></select></label><label>Quelle<select @bind="source"><option value="">Alle</option>@foreach(var item in Sources){<option>@item</option>}</select></label><span class="subtle">@Logs.Count() von @State.Logs.Length geladenen Einträgen</span></div>
<section class="panel log-panel">@foreach(var log in Logs){<details class="log-entry"><summary><span class="mono">@Format.Date(log.Timestamp)</span><span class="pill @Format.Tone(log.Severity)">@log.Severity</span><span class="log-source">@log.Source</span><span class="log-preview">@log.Message.Split('\n')[0]</span></summary><pre>@log.Message</pre></details>}@if(!Logs.Any()){<p class="empty">Keine passenden Ereignisse. Router-Syslog erscheint erst nach Einrichtung des Senders und Empfängers unter Einstellungen.</p>}</section><p class="footnote">@Platform.LogsNote</p>
@code {
    [Parameter] public MonitorState State { get; set; } = new();
    private string search = "", severity = "", source = "";
    /// <summary>Quellen kommen aus den vorhandenen Einträgen: Windows nutzt andere als Android.</summary>
    private IEnumerable<string> Sources => State.Logs.Select(l => l.Source).Distinct().OrderBy(s => s, StringComparer.CurrentCulture);
    private IEnumerable<LogEntry> Logs => State.Logs.Where(l => (severity == "" || l.Severity == severity) && (source == "" || l.Source.StartsWith(source)) && $"{l.Source} {l.Message}".Contains(search, StringComparison.OrdinalIgnoreCase));
}
