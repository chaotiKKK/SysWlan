@inject DesktopActions Actions
<div class="section-heading"><div><span class="eyebrow">WLAN &amp; ROUTERVERWALTUNG</span><h2>Dein Zugang. Deine Einstellungen.</h2></div><span class="pill muted">@State.Router.Vendor</span></div>
<div class="two-columns"><section class="panel"><div class="panel-heading"><h3>Aktuelle WLAN-Verbindung</h3><span class="source">WINDOWS</span></div><dl class="details"><dt>SSID</dt><dd>@Format.Value(State.Snapshot?.Ssid)</dd><dt>BSSID</dt><dd class="mono">@Format.Value(State.Snapshot?.Wlan.Bssid)</dd><dt>Sicherheit</dt><dd>@Format.Value(State.Snapshot?.Wlan.Authentication)</dd><dt>Verschlüsselung</dt><dd>@Format.Value(State.Snapshot?.Wlan.Cipher)</dd><dt>Band / Kanal</dt><dd>@Format.Value(State.Snapshot?.Wlan.Band) / @Format.Value(State.Snapshot?.Wlan.Channel)</dd><dt>Band Steering</dt><dd>@(State.Router.BandSteering is null ? "Unbekannt" : State.Router.BandSteering == true ? "Aktiv (Routerstatus)" : "Inaktiv (Routerstatus)")</dd></dl></section>
<section class="panel"><div class="panel-heading"><h3>Gastnetz &amp; Konfiguration</h3><span class="pill warn">Routeranmeldung</span></div><p>Gast-WLAN erstellen, SSID ändern, Geräte verwalten und Routerlogs ansehen: Öffne dafür die integrierte Originaloberfläche deines Routers.</p><p>Verfügbare Optionen und Berechtigungen bestimmt die Routerfirmware. Direkte automatisierte Konfigurationsänderungen unterstützt dieser Adapter noch nicht.</p><div class="toolbar"><button class="button" disabled="@(State.ProfileId is null)" @onclick="Open">Routerverwaltung öffnen ↗</button><label class="check"><input type="checkbox" @bind="https" />HTTPS verwenden</label></div><p class="footnote">HTTP verschlüsselt den Transport nicht. HTTPS nur verwenden, wenn der Router es unterstützt; Zertifikatfehler werden nicht umgangen.</p></section></div>
<section class="panel editor"><div class="panel-heading"><div><h3>Routerzugang speichern</h3><p>Optional · nur für dieses verbundene Profil</p></div><span class="pill @(saved ? "good" : "muted")">@(saved ? "Zugang gespeichert" : "Ohne gespeicherten Zugang")</span></div><p>Die App speichert den Zugang im Windows-Geheimnisspeicher. Im Routerfenster kannst du ihn per Schaltfläche in die erkannte ARRIS-Anmeldeseite einsetzen und dort die Anmeldung bestätigen. Andere Router meldest du direkt in ihrer Oberfläche an.</p><div class="form-row"><label>Benutzername<input autocomplete="off" maxlength="100" @bind="username" /></label><label>Routerpasswort<input type="password" autocomplete="new-password" maxlength="512" @bind="password" /></label></div><div class="toolbar"><button class="button" disabled="@(State.ProfileId is null || password.Length == 0)" @onclick="Save">Zugang sicher speichern</button><button class="button secondary" disabled="@(!saved)" @onclick="Forget">Gespeicherten Zugang entfernen</button></div><p class="footnote">Das Entfernen löscht das gespeicherte Passwort. Eine laufende Sitzung beendest du über „Abmelden“ im Routerfenster. Bei pausierter Erfassung oder Netzwerkänderung wird das Routerfenster geschlossen.</p><p role="status">@message</p></section>
@code {
    [Parameter] public MonitorState State { get; set; } = new();
    private string username = "admin", password = "", message = ""; private string? loadedProfile; private bool saved, https;
    protected override async Task OnParametersSetAsync() { if(loadedProfile != State.ProfileId) { loadedProfile = State.ProfileId; password = ""; saved = loadedProfile is not null && await Actions.HasCredentialAsync(loadedProfile); } }
    private async Task Open() { try { await Actions.OpenRouterAsync(State.ProfileId!, https); message = "Routerverwaltung geöffnet."; } catch(Exception ex){ message = ex.Message; } }
    private async Task Save() { try { await Actions.SaveCredentialAsync(State.ProfileId!, username, password); password = ""; saved = true; message = "Zugang sicher gespeichert."; } catch(Exception ex){ message = ex.Message; } }
    private void Forget() { if(State.ProfileId is null) return; Actions.ForgetCredential(State.ProfileId); saved = false; password = ""; message = "Gespeicherten Zugang entfernt."; }
}
