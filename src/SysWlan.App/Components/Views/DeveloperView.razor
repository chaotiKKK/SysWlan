@inject IPlatformActions Actions
@inject IPlatformInfo Platform
<div class="section-heading"><div><span class="eyebrow">QUELLEN &amp; DIAGNOSE</span><h2>Entwicklerwerkzeuge</h2></div><span class="pill muted">@Platform.PlatformLabel</span></div>
<section class="panel"><h3>Namensauflösung prüfen</h3><p>@Platform.DnsNote Der Hostname wird an den konfigurierten Resolver übergeben.</p><div class="toolbar"><label>Hostname<input placeholder="example.com" @bind="host" /></label><button class="button" disabled="@busy" @onclick="Resolve">@(busy ? "Wird geprüft …" : "DNS prüfen")</button></div><pre class="result" role="status">@result</pre></section>
<section class="panel table-panel"><div class="panel-heading"><h3>Funktionsmatrix dieser Plattform</h3><span class="subtle">@Platform.DeviceLabel</span></div><table><thead><tr><th>Funktion</th><th>Quelle</th><th>Zugriff</th></tr></thead><tbody>@foreach(var row in Platform.Capabilities){<tr><td>@row.Feature</td><td>@row.Source</td><td>@row.Access</td></tr>}</tbody></table></section>
<section class="panel"><h3>Aktueller Diagnosezustand</h3><p>Nur freigegebene Statusfelder; keine HTML-Seiten oder Sitzungsschlüssel. Routerstatus: @(State.Router.Error ?? "Firmwareabhängig verfügbar")</p><pre class="json-view">@Json</pre></section>
@code {
    [Parameter] public MonitorState State { get; set; } = new();
    private string host = "example.com", result = ""; private bool busy;
    private string Json => System.Text.Json.JsonSerializer.Serialize(new { capturedAt = State.Snapshot?.Timestamp, profileId = State.ProfileId, gatewayIdentity = new { mac = State.Snapshot?.GatewayMac, source = State.Snapshot?.GatewayMacSource, meaning = GatewayIdentityPolicy.Describe(State.Snapshot?.GatewayMacSource) }, router = State.Router, addresses = State.Snapshot?.Addresses, dns = State.Snapshot?.DnsServers, traffic = new { deviceBytes = new[] { State.Snapshot?.ReceivedBytes, State.Snapshot?.SentBytes }, appBytes = new[] { State.Snapshot?.AppReceivedBytes, State.Snapshot?.AppSentBytes } }, errors = State.Snapshot?.Errors }, new System.Text.Json.JsonSerializerOptions{WriteIndented=true});
    private async Task Resolve(){busy=true;try{result=await Actions.ResolveAsync(host.Trim());}catch(Exception ex){result="DNS-Prüfung fehlgeschlagen: "+ex.Message;}finally{busy=false;}}
}
