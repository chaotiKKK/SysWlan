@inject CalendarQueryService Calendar
@inject Store Store
@inject IPlatformActions Actions
<section class="calendar-page" data-theme="@(dark ? "dark" : "light")">
    <div class="section-heading">
        <div><span class="eyebrow">ZEITACHSE &amp; BEOBACHTUNG</span><h2>Gerätekalender</h2><p class="subtle">Lokale Beobachtungen · keine vollständige Router-Clientliste</p></div>
        <div class="calendar-toolbar"><button class="button secondary small" @onclick="Previous">‹</button><button class="button secondary small" @onclick="Today">Heute</button><button class="button secondary small @(mode == CalendarViewMode.Week ? "active" : "")" @onclick="() => SetMode(CalendarViewMode.Week)">Woche</button><button class="button secondary small @(mode == CalendarViewMode.Day ? "active" : "")" @onclick="() => SetMode(CalendarViewMode.Day)">Tag</button><button class="button secondary small @(mode == CalendarViewMode.Month ? "active" : "")" @onclick="() => SetMode(CalendarViewMode.Month)">Monat</button><button class="button secondary small" @onclick="Next">›</button></div>
    </div>
    <div class="calendar-meta"><strong>@Title</strong><span>@snapshot.Devices.Count(d => d.IsVisible) Geräte · @snapshot.Presence.Length Intervalle · @snapshot.Events.Length Ereignisse</span><button class="button small" @onclick="Export">.ics exportieren</button></div>
    <div class="toolbar calendar-filters"><label class="check"><input type="checkbox" @bind="showPresence" /> Anwesenheit</label><label class="check"><input type="checkbox" @bind="showActivity" /> Aktivität</label><label class="check"><input type="checkbox" @bind="showEvents" /> Ereignisse</label><label class="check"><input type="checkbox" checked="@dark" @onchange="ToggleDark" /> Dunkelmodus</label></div>
    @if (snapshot.Presence.Length == 0 && snapshot.Events.Length == 0) { <div class="notice">Noch keine Geräteintervalle. Die Kalenderansicht füllt sich nach beobachteten Erfassungen.</div> }
    else if (mode == CalendarViewMode.Week) { <WeekCalendar Snapshot="snapshot" Anchor="anchor" ShowPresence="showPresence" ShowActivity="showActivity" ShowEvents="showEvents" /> }
    else if (mode == CalendarViewMode.Day) { <DayTimeline Snapshot="snapshot" ShowPresence="showPresence" ShowActivity="showActivity" ShowEvents="showEvents" /> }
    else { <MonthHeatmap Snapshot="snapshot" Anchor="anchor" /> }
    <section class="panel device-management"><div class="panel-heading"><div><h3>Geräteprofile</h3><p>Farbe und Zuordnung können ohne Löschen des Verlaufs korrigiert werden.</p></div></div>
        @foreach (var device in snapshot.Devices.Where(d => d.IsVisible)) { <div class="device-editor"><span class="device-color" style="background:@device.Color"></span><input aria-label="Name von @device.Name" value="@device.Name" @onchange="e => Rename(device, e.Value?.ToString() ?? device.Name)" /><input aria-label="Farbe von @device.Name" type="color" value="@device.Color" @onchange="e => Recolor(device, e.Value?.ToString())" /><select aria-label="Quelle für Trennung von @device.Name" @bind="splitSource"><option value="">Quelle trennen …</option>@foreach(var source in device.SourceKeys){<option value="@source">@source</option>}</select><button class="button secondary small" @onclick="() => Split(device)">Trennen</button><label class="check"><input type="checkbox" checked="@mergeSources.Contains(device.Id)" @onchange="e => ToggleMerge(device.Id, e)" /> Zusammenführen</label></div> }
        <div class="toolbar"><select @bind="mergeTarget"><option value="">Zielprofil wählen …</option>@foreach(var device in snapshot.Devices){<option value="@device.Id">@device.Name</option>}</select><button class="button secondary small" disabled="@(string.IsNullOrWhiteSpace(mergeTarget) || mergeSources.Count == 0)" @onclick="Merge">Ausgewählte Profile zusammenführen</button></div>
    </section>
    @if (message.Length > 0) { <p class="action-status" role="status">@message</p> }
</section>
@code {
    private CalendarViewMode mode = CalendarViewMode.Week;
    private DateOnly anchor = DateOnly.FromDateTime(DateTime.Now);
    private CalendarSnapshot snapshot = new([], [], [], []);
    private bool showPresence = true, showActivity = true, showEvents = true, dark;
    private string message = "", mergeTarget = "", splitSource = "";
    private readonly HashSet<string> mergeSources = new(StringComparer.Ordinal);
    protected override void OnInitialized() => Reload();
    private string Title => mode switch { CalendarViewMode.Day => anchor.ToString("dddd, d. MMMM", System.Globalization.CultureInfo.CurrentCulture), CalendarViewMode.Month => anchor.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture), _ => $"Woche ab {anchor:dd.MM.yyyy}" };
    private void Reload() { snapshot = mode switch { CalendarViewMode.Day => Calendar.GetDay(anchor), CalendarViewMode.Month => Calendar.GetMonth(anchor), _ => Calendar.GetWeek(anchor) }; }
    private void SetMode(CalendarViewMode value) { mode = value; Reload(); }
    private void Previous() { anchor = mode == CalendarViewMode.Month ? anchor.AddMonths(-1) : anchor.AddDays(mode == CalendarViewMode.Week ? -7 : -1); Reload(); }
    private void Next() { anchor = mode == CalendarViewMode.Month ? anchor.AddMonths(1) : anchor.AddDays(mode == CalendarViewMode.Week ? 7 : 1); Reload(); }
    private void Today() { anchor = DateOnly.FromDateTime(DateTime.Now); Reload(); }
    private void ToggleDark(ChangeEventArgs args) => dark = bool.TryParse(args.Value?.ToString(), out var value) && value;
    private async Task Export() { try { message = await Actions.ExportCalendarAsync(anchor, mode); } catch(Exception ex) { message = SyslogParser.Redact(ex.Message); } }
    private void Rename(CalendarDevice device, string value) { try { Store.UpdateCalendarDevice(device.Id, value, device.ManualColor, device.Icon, device.IsVisible); Reload(); message = "Gerätename gespeichert."; } catch(Exception ex) { message = ex.Message; } }
    private void Recolor(CalendarDevice device, string? value) { try { Store.UpdateCalendarDevice(device.Id, device.Name, value, device.Icon, device.IsVisible); Reload(); message = "Gerätefarbe gespeichert."; } catch(Exception ex) { message = ex.Message; } }
    private void ToggleMerge(string id, ChangeEventArgs args) { if (bool.TryParse(args.Value?.ToString(), out var selected) && selected) mergeSources.Add(id); else mergeSources.Remove(id); }
    private void Merge() { try { Store.MergeDeviceProfiles(mergeTarget, mergeSources.Where(id => id != mergeTarget)); mergeSources.Clear(); Reload(); message = "Profile reversibel zusammengeführt."; } catch(Exception ex) { message = ex.Message; } }
    private void Split(CalendarDevice device) { try { if (string.IsNullOrWhiteSpace(splitSource)) throw new InvalidOperationException("Bitte zuerst eine Quelle auswählen."); Store.SplitDeviceSources(device.Id, [splitSource], device.Name + " (getrennt)", device.ManualColor); splitSource = ""; Reload(); message = "Quelle getrennt; der Verlauf bleibt erhalten."; } catch(Exception ex) { message = ex.Message; } }
}
