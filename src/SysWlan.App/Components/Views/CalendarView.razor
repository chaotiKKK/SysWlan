@inject CalendarQueryService Calendar
@inject Store Store
@inject DesktopActions Actions
<section class="calendar-page" data-theme="@(dark ? "dark" : "light")">
    <div class="section-heading"><div><span class="eyebrow">ZEITACHSE &amp; BEOBACHTUNG</span><h2>Gerätekalender</h2><p class="subtle">Lokale Beobachtungen · keine vollständige Router-Clientliste</p></div><div class="calendar-toolbar"><button class="button secondary small" @onclick="Previous">‹</button><button class="button secondary small" @onclick="Today">Heute</button><button class="button secondary small @(mode == CalendarViewMode.Week ? "active" : "")" @onclick="() => SetMode(CalendarViewMode.Week)">Woche</button><button class="button secondary small @(mode == CalendarViewMode.Day ? "active" : "")" @onclick="() => SetMode(CalendarViewMode.Day)">Tag</button><button class="button secondary small @(mode == CalendarViewMode.Month ? "active" : "")" @onclick="() => SetMode(CalendarViewMode.Month)">Monat</button><button class="button secondary small" @onclick="Next">›</button></div></div>
    <div class="calendar-meta"><strong>@Title</strong><span>@snapshot.Devices.Count(d => d.IsVisible) Geräte · @snapshot.Presence.Length Intervalle · @snapshot.Events.Length Ereignisse</span><button class="button small" @onclick="Export">.ics exportieren</button></div>
    <div class="toolbar calendar-filters"><label class="check"><input type="checkbox" @bind="showPresence" /> Anwesenheit</label><label class="check"><input type="checkbox" @bind="showActivity" /> Aktivität</label><label class="check"><input type="checkbox" @bind="showEvents" /> Ereignisse</label><label class="check"><input type="checkbox" checked="@dark" @onchange="ToggleDark" /> Dunkelmodus</label></div>
    @if (snapshot.Presence.Length == 0 && snapshot.Events.Length == 0) { <div class="notice">Noch keine Geräteintervalle. Die Kalenderansicht füllt sich nach beobachteten Erfassungen.</div> }
    else { <div class="calendar-grid">@foreach (var device in snapshot.Devices.Where(d => d.IsVisible)) { var color = device.Color; <section class="calendar-device panel" style="--device-color:@color"><div class="device-title"><span class="device-color" aria-hidden="true"></span><strong>@device.Name</strong><code>@device.SourceKeys.Length Quelle(n)</code></div>@if(showPresence){foreach(var interval in Intervals(device)){<div class="presence-bar" title="@interval.Quality"><span>@(interval.IsOpen ? "Aktuell beobachtet" : "Anwesend")</span><small>@Format.Date(interval.Start) – @(interval.End is null ? "jetzt" : Format.Date(interval.End.Value))</small></div>}}@if(showActivity){foreach(var activity in Activities(device)){<div class="activity-row"><span>Aktivität</span><span>@(activity.Availability == ActivityAvailability.Available ? $"↓ {activity.ReceiveMbps:N1} / ↑ {activity.SendMbps:N1} MBit/s" : "nicht verfügbar")</span></div>}}@if(showEvents){foreach(var entry in Events(device)){<div class="calendar-event"><span aria-hidden="true">@(entry.Type == DeviceEventType.CollectionError ? "!" : entry.Type == DeviceEventType.Absence ? "▲" : "●")</span><span>@entry.Message</span><small>@Format.Date(entry.Timestamp)</small></div>}}</section> }</div> }
    @if (message.Length > 0) { <p class="action-status" role="status">@message</p> }
</section>
@code {
    private CalendarViewMode mode = CalendarViewMode.Week; private DateOnly anchor = DateOnly.FromDateTime(DateTime.Now); private CalendarSnapshot snapshot = new([], [], [], []); private bool showPresence = true, showActivity = true, showEvents = true, dark; private string message = "";
    protected override void OnInitialized() => Reload();
    private string Title => mode switch { CalendarViewMode.Day => anchor.ToString("dddd, d. MMMM", System.Globalization.CultureInfo.CurrentCulture), CalendarViewMode.Month => anchor.ToString("MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture), _ => $"Woche ab {anchor:dd.MM.yyyy}" };
    private void Reload() { snapshot = mode switch { CalendarViewMode.Day => Calendar.GetDay(anchor), CalendarViewMode.Month => Calendar.GetMonth(anchor), _ => Calendar.GetWeek(anchor) }; }
    private void SetMode(CalendarViewMode value) { mode = value; Reload(); }
    private void Previous() { anchor = mode == CalendarViewMode.Month ? anchor.AddMonths(-1) : anchor.AddDays(mode == CalendarViewMode.Week ? -7 : -1); Reload(); }
    private void Next() { anchor = mode == CalendarViewMode.Month ? anchor.AddMonths(1) : anchor.AddDays(mode == CalendarViewMode.Week ? 7 : 1); Reload(); }
    private void Today() { anchor = DateOnly.FromDateTime(DateTime.Now); Reload(); }
    private void ToggleDark(ChangeEventArgs args) { dark = bool.TryParse(args.Value?.ToString(), out var value) && value; }
    private IEnumerable<PresenceInterval> Intervals(CalendarDevice d) => snapshot.Presence.Where(p => d.SourceKeys.Contains(p.SourceKey));
    private IEnumerable<ActivityAggregate> Activities(CalendarDevice d) => snapshot.Activity.Where(p => d.SourceKeys.Contains(p.SourceKey));
    private IEnumerable<DeviceEvent> Events(CalendarDevice d) => snapshot.Events.Where(p => d.SourceKeys.Contains(p.SourceKey));
    private async Task Export() { try { message = "Kalender exportiert: " + await Actions.ExportCalendarAsync(anchor, mode); } catch(Exception ex) { message = SyslogParser.Redact(ex.Message); } }
}
