@inject IPlatformInfo Platform
<div class="section-heading"><div><span class="eyebrow">@Platform.DeviceLabel.ToUpperInvariant()</span><h2>Verbindungen &amp; Prozesse</h2></div><input class="search" aria-label="Verbindungen suchen" placeholder="Prozess, IP oder Port suchen …" @bind="search" @bind:event="oninput" /></div>
<div class="toolbar"><label>Protokoll <select @bind="protocol"><option value="">Alle</option><option>TCP</option><option>UDP</option></select></label><label class="check"><input type="checkbox" @bind="onlyEstablished" />Nur aktive TCP-Verbindungen</label><span class="subtle">@Connections.Count() Treffer · systemweite Momentaufnahme</span></div>
<section class="panel table-panel"><table><thead><tr><th>Prozess / PID</th><th>Protokoll</th><th>Lokal</th><th>Gegenstelle</th><th>Status</th></tr></thead><tbody>
@foreach(var item in Connections.Take(300)){<tr><td><strong>@(item.ProcessName.Length > 0 ? item.ProcessName : "Nicht auflösbar")</strong><small>PID @item.ProcessId</small></td><td class="mono">@item.Protocol</td><td class="mono">@item.LocalAddress<span class="subtle">:@item.LocalPort</span></td><td class="mono">@(item.RemoteAddress.Length > 0 ? $"{item.RemoteAddress}:{item.RemotePort}" : "Keine Gegenstelle (UDP)")</td><td><span class="pill @(item.State == "Established" ? "good" : "muted")">@item.State</span></td></tr>}
</tbody></table>@if(!Connections.Any()){<p class="empty">Keine passenden Verbindungen.</p>}</section><p class="footnote">@Platform.ConnectionsNote</p>
@code {
    [Parameter] public MonitorState State { get; set; } = new();
    private string search = "", protocol = ""; private bool onlyEstablished;
    private IEnumerable<ConnectionInfo> Connections => (State.Snapshot?.Connections ?? []).Where(c => (protocol == "" || c.Protocol == protocol) && (!onlyEstablished || c.State == "Established") && $"{c.ProcessName} {c.ProcessId} {c.LocalAddress}:{c.LocalPort} {c.RemoteAddress}:{c.RemotePort}".Contains(search, StringComparison.OrdinalIgnoreCase)).OrderByDescending(c => c.State == "Established").ThenBy(c => c.ProcessName);
}
