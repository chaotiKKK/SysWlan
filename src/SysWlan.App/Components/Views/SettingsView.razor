@inject Store Store
@inject SyslogReceiver Syslog
@inject MonitorService Monitor
@inject IPlatformActions Actions
@inject IPlatformInfo Platform
@inject IPlatformPermissions Permissions
@inject IBackgroundMonitoring Background
@inject CalendarSyncRegistration CalDav
<div class="section-heading"><div><span class="eyebrow">LOKAL &amp; UNTER DEINER KONTROLLE</span><h2>Einstellungen</h2></div></div>
<div class="two-columns"><section class="panel editor"><h3>Erfassung &amp; Aufbewahrung</h3><label>Pause zwischen Abfragen (Sekunden)<input type="number" min="3" max="60" @bind="interval" /></label><label>Messwerte und Logs aufbewahren (Tage)<input type="number" min="1" max="365" @bind="retention" /></label><p class="footnote">Die Abfrage selbst benötigt zusätzlich Zeit. Profilnamen und beobachtete Gesamtdatenmengen bleiben erhalten. Höchstens 50.000 Logeinträge werden aufbewahrt.</p><button class="button" @onclick="Save">Einstellungen speichern</button></section>
<section class="panel editor"><div class="panel-heading"><h3>Syslog empfangen</h3><span class="pill @(Syslog.Running ? "good" : "muted")">@(Syslog.Running ? Syslog.Endpoint : "Ausgeschaltet")</span></div><label>Lokale Adresse<select @bind="bindAddress"><option value="">Adresse wählen</option><option>127.0.0.1</option>@foreach(var address in State.Snapshot?.Addresses.Where(a => !a.Contains(':')) ?? []){<option>@address</option>}</select></label><label>UDP-Port<input type="number" min="1024" max="65535" @bind="port" /></label><p class="footnote">Trage diese Zieladresse und den Port im Router als Syslog-Empfänger ein, sofern er Syslog-Versand unterstützt. Eine Firewallfreigabe kann nötig sein. Maximal 50 Nachrichten pro Sekunde; kein automatischer Start.</p><div class="toolbar"><button class="button" disabled="@(bindAddress.Length == 0 || Syslog.Running)" @onclick="StartSyslog">Empfang starten</button><button class="button secondary" disabled="@(!Syslog.Running)" @onclick="StopSyslog">Stoppen</button></div>@if(Syslog.Error is not null){<p class="error">@Syslog.Error</p>}</section></div>
<section class="panel"><h3>Daten exportieren</h3><p>Profile, bis zu 2.000 letzte Messpunkte je Profil und bis zu 1.000 Logeinträge als JSON. Der Export enthält Netzwerkadressen und persönliche Profilnotizen. Routerzugänge sind ausgeschlossen.</p><button class="button secondary" @onclick="Export">JSON-Export erstellen</button></section>
@if (Permissions.IsRelevant) { <section class="panel editor"><div class="panel-heading"><div><h3>Plattformberechtigungen</h3><p>@Platform.DeviceLabel · ohne diese Rechte zeigt die App „nicht verfügbar“ statt geschätzter Werte</p></div><span class="pill muted">@Platform.PlatformLabel.ToUpperInvariant()</span></div>
    @foreach (var row in Permissions.Rows()) { <p class="footnote">@row</p> }
    <div class="toolbar">@if(Permissions.CanRequestWifiDetails){<button class="button" @onclick="RequestWifi">WLAN-Berechtigung anfragen</button>}@if(Permissions.NeedsTrafficAccess){<button class="button secondary" @onclick="OpenTrafficAccess">Nutzungszugriff eröffnen</button>}<button class="button secondary" @onclick="ReadPermissions">Zustand neu lesen</button></div></section> }
@if (Background.IsSupported) { <section class="panel editor"><div class="panel-heading"><div><h3>Dauerhaftes Monitoring</h3><p>@Background.Description</p></div><span class="pill @(Background.IsActive ? "good" : "muted")">@(Background.IsActive ? "Dienst aktiv" : "Nur im Vordergrund")</span></div>
    <div class="toolbar"><button class="button" disabled="@(Background.IsActive)" @onclick="StartBackground">Vordergrunddienst starten</button><button class="button secondary" disabled="@(!Background.IsActive)" @onclick="StopBackground">Dienst stoppen</button></div></section> }
<section class="panel editor"><h3>Offener Kalender (CalDAV)</h3><p>Optional: App→CalDAV-Synchronisation für den gemeinsamen Kalender <strong>Netzwerkgeräte</strong>. Die lokale Kalenderansicht funktioniert ohne Server weiter. Konfiguration: <code>@CalDav.ConfigurationPath</code></p><label>Server-URL<input @bind="caldavUrl" placeholder="https://calendar.example/remote.php/dav/calendars/user/network" /></label><div class="form-row"><label>Benutzername<input @bind="caldavUser" /></label><label>Passwort<input type="password" @bind="caldavPassword" /></label></div><label>Kalendername<input @bind="caldavCalendar" /></label><div class="toolbar"><button class="button" @onclick="SaveCalDav">CalDAV-Konfiguration speichern</button><span class="subtle">@CalDav.SafeStatus()</span></div></section><p class="action-status" role="status">@message</p>
@code {
    [Parameter] public MonitorState State { get; set; } = new();
    private int interval = 5, retention = 30, port = 5514; private string bindAddress = "", message = ""; private string caldavUrl = "", caldavUser = "", caldavPassword = "", caldavCalendar = "Netzwerkgeräte";
    protected override void OnInitialized() { if(int.TryParse(Store.GetSetting("intervalSeconds"), out var i)) interval = i; if(int.TryParse(Store.GetSetting("retentionDays"), out var d)) retention = d; try { var options = CalDav.Load(); caldavUrl = options.Url ?? ""; caldavUser = options.Username ?? ""; caldavPassword = options.Password ?? ""; caldavCalendar = options.CalendarName; } catch { } }
    private void Save(){if(interval is < 3 or > 60 || retention is < 1 or > 365){message="Intervall: 3–60 Sekunden. Aufbewahrung: 1–365 Tage.";return;}Store.SetSetting("intervalSeconds", interval.ToString());Store.SetSetting("retentionDays", retention.ToString());Store.Prune(retention);message="Einstellungen gespeichert; Aufbewahrungsregel angewendet.";}
    private void StartSyslog(){try{Syslog.Start(bindAddress,port);message="Syslog-Empfänger gestartet.";}catch(Exception ex){message=ex.Message;}}
    private void StopSyslog(){Syslog.Stop();message="Syslog-Empfänger gestoppt.";}
    private async Task Export(){try{message=await Actions.ExportAsync();}catch(Exception ex){message=ex.Message;}}
    private void ReadPermissions() => message = "Berechtigungszustand neu gelesen.";
    private async Task RequestWifi(){message=await Permissions.RequestWifiDetailsAsync();}
    private async Task OpenTrafficAccess(){message=await Permissions.OpenTrafficAccessAsync();}
    private async Task StartBackground(){message=await Background.StartAsync();}
    private async Task StopBackground(){message=await Background.StopAsync();}
    private void SaveCalDav(){try{new CalDavConfigurationProvider().Save(CalDav.ConfigurationPath, new CalDavOptions(caldavUrl, caldavUser, caldavPassword, caldavCalendar)); message="CalDAV-Konfiguration gespeichert.";}catch(Exception ex){message=SyslogParser.Redact(ex.Message);}}
}
